{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "custom-post-type-events/events-date",
    "title": "Events Date",
    "category": "widgets",
    "icon": "category",
    "description": "Display the events date",
    "textdomain": "custom-post-type-events",
    "attributes": {
        "format": {
            "type": "string",
            "default": ""
        },
        "timeSeparator": {
            "type": "string",
            "default": " | "
        },
        "showTime": {
            "type": "boolean",
            "default": true
        },
        "showEndDate": {
            "type": "boolean",
            "default": true
        },
        "oneLineRange": {
            "type": "boolean",
            "default": false
        },
        "dateRangeSeparator": {
            "type": "string",
            "default": "\u2013"
        },
        "timeFormat": {
            "type": "string",
            "default": "H:i"
        }
    },
    "usesContext": [
        "postId",
        "postType"
    ],
    "supports": {
        "color": {
            "background": true,
            "text": true
        },
        "spacing": {
            "margin": true,
            "padding": true,
            "blockGap": true
        }
    },
    "editorScript": "file:./index.js",
    "style": "file:./index.css",
    "render": "file:./render.php"
}
